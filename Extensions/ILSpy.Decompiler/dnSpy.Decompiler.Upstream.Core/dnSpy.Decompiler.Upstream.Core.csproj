<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\DnSpyCommon.props" />

  <!--
    Adapter between dnSpy (dnlib) and the unmodified upstream ILSpy decompiler engine (ICSharpCode.Decompiler NuGet).
    Must not reference WPF/WinForms so it can be tested headlessly on any OS.
  -->
  <PropertyGroup>
    <Version>$(DnSpyAssemblyVersion)</Version>
    <InformationalVersion>$(DnSpyAssemblyInformationalVersion)</InformationalVersion>
    <Copyright>$(DnSpyAssemblyCopyright)</Copyright>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\dnSpy.snk</AssemblyOriginatorKeyFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\dnSpy\dnSpy.Contracts.Logic\dnSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\..\..\dnSpy\dnSpy.Decompiler\dnSpy.Decompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="$(ILSpyDecompilerVersion)" />
    <PackageReference Include="System.Reflection.Metadata" Version="$(DotNetPackageVersion)" />
  </ItemGroup>

</Project>
