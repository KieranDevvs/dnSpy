<Project>
  <!--
    The legacy decompiler fork has the same namespaces and type names as the upstream ICSharpCode.Decompiler package.
    Projects that reference both (directly or through dnSpy.Decompiler.ILSpy.Core) hide the fork's types behind an
    extern alias. Remove this with the legacy engine.
  -->
  <Target Name="AliasLegacyDecompiler" AfterTargets="FindReferenceAssembliesForReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Condition=" '%(Filename)' == 'ICSharpCode.Decompiler.Legacy' or '%(Filename)' == 'ICSharpCode.NRefactory' or '%(Filename)' == 'ICSharpCode.NRefactory.CSharp' or '%(Filename)' == 'ICSharpCode.NRefactory.VB' ">
        <Aliases>legacy</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>
</Project>
